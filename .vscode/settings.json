{
  // The dot on a tab means the editor buffer has unsaved changes. VS Code will
  // not auto-reload a dirty buffer from disk, so if a file is edited outside
  // the editor while the dot is showing, saving writes the stale buffer over
  // it. Flushing the buffer within a second keeps that window tiny.
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,

  // Don't carry unsaved buffers across restarts — they come back dirty and
  // immediately conflict with whatever is on disk.
  "files.hotExit": "off",

  // src/index.css is generated by `tailwindcss -o` and rewritten on every
  // build. Marking it read-only stops the editor saving over the build output.
  "files.readonlyInclude": {
    "src/index.css": true
  },

  // The repo is 2-space; Hero.jsx got reformatted to 4. Pin it so saves stop
  // rewriting whole files.
  "editor.tabSize": 2,
  "editor.detectIndentation": false,

  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true
  }
}
